    .facilitator-section {
      padding: 8rem 0;
      background: rgba(15, 15, 20, 0.5);
      color: rgba(255, 255, 255, 0.95);
      position: relative;
    }

    .facilitator-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.1),
        transparent
      );
    }

    .facilitator-content {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 4rem;
      align-items: center;
      margin-top: 3rem;
    }

    .facilitator-image {
      text-align: center;
      position: relative;
    }

    .facilitator-image::before {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 350px;
      height: 350px;
      background: radial-gradient(
        circle,
        rgba(201, 169, 97, 0.1) 0%,
        transparent 70%
      );
      border-radius: 50%;
      z-index: 0;
    }

    .doctor-photo {
      width: 320px;
      height: 320px;
      object-fit: cover;
      border-radius: 50%;
      margin: 0 auto;
      display: block;
      border: 1px solid rgba(201, 169, 97, 0.3);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      z-index: 1;
    }

    .doctor-photo:hover {
      transform: scale(1.03);
      box-shadow: 0 25px 80px rgba(0, 0, 0, 0.6);
      border-color: rgba(201, 169, 97, 0.5);
    }

    .facilitator-label {
      font-family: var(--font-secondary);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: rgba(201, 169, 97, 0.8);
      margin-bottom: 1rem;
      font-weight: 400;
    }

    .facilitator-name {
      font-family: var(--font-primary);
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 300;
      margin-bottom: 0.75rem;
      letter-spacing: 1px;
      color: rgba(255, 255, 255, 0.95);
    }

    .facilitator-title {
      font-family: var(--font-secondary);
      font-size: 1.2rem;
      font-style: italic;
      font-weight: 300;
      margin-bottom: 2rem;
      color: rgba(255, 255, 255, 0.75);
    }

    .facilitator-description {
      font-family: var(--font-secondary);
      font-size: 1.05rem;
      font-weight: 300;
      line-height: 1.9;
      color: rgba(255, 255, 255, 0.7);
      letter-spacing: 0.3px;
    }

    .facilitator-description em {
      color: rgba(201, 169, 97, 0.9);
      font-style: italic;
    }

    .facilitator-description strong {
      color: rgba(255, 255, 255, 0.9);
      font-weight: 400;
    }

    /* Approach Section */
    .investment-section {
      padding: 8rem 0;
      background: #0a0a0f;
      color: rgba(255, 255, 255, 0.95);
      position: relative;
      background-repeat: no-repeat !important;
      -webkit-background-size: cover !important;
      background-size: cover !important;
      min-height: 100vh;
    }

    .investment-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.1),
        transparent
      );
    }

    .approach-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: 2.5rem;
      margin-top: 4rem;
    }

    .approach-column {
      background: rgba(15, 15, 20, 0.6);
      backdrop-filter: blur(20px);
      padding: 3rem;
      border-radius: 16px;
      border: 1px solid rgba(255, 255, 255, 0.06);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      position: relative;
      overflow: hidden;
    }

    .approach-column::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 0;
      height: 100%;
      background: linear-gradient(180deg, #c9a961 0%, transparent);
      transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .approach-column:hover {
      transform: translateY(-6px);
      border-color: rgba(201, 169, 97, 0.2);
      background: rgba(20, 20, 25, 0.7);
    }

    .approach-column:hover::before {
      width: 2px;
    }

    .approach-title {
      font-family: var(--font-primary);
      font-size: 1.6rem;
      font-weight: 400;
      margin-bottom: 2rem;
      color: rgba(255, 255, 255, 0.95);
      letter-spacing: 0.5px;
      position: relative;
      z-index: 1;
    }

    .approach-list {
      list-style: none;
      padding: 0;
      position: relative;
      z-index: 1;
    }

    .approach-list li {
      padding: 0.75rem 0;
      padding-left: 2rem;
      position: relative;
      line-height: 1.8;
      font-family: var(--font-secondary);
      font-weight: 300;
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.7);
      letter-spacing: 0.3px;
      transition: all 0.3s ease;
    }

    .approach-list li:hover {
      color: rgba(255, 255, 255, 0.9);
      padding-left: 2.3rem;
    }

    .approach-list li::before {
      content: "→";
      position: absolute;
      left: 0;
      color: #c9a961;
      font-weight: 300;
      font-size: 1.2rem;
      transition: all 0.3s ease;
    }

    .approach-list li:hover::before {
      transform: translateX(3px);
    }

    /* Experience Section */
    .experience-section {
      padding: 8rem 0;
      background: rgba(15, 15, 20, 0.4);
      position: relative;
    }

    .experience-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.1),
        transparent
      );
    }

    .experience-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      margin-top: var(--spacing-lg);
    }

    .experience-item {
      background: rgba(15, 15, 20, 0.6);
      backdrop-filter: blur(20px);
      padding: 2.5rem;
      border-radius: 16px;
      text-align: center;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid rgba(255, 255, 255, 0.06);
      position: relative;
      overflow: hidden;
    }

    .experience-item::before {
      content: "";
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      height: 0;
      background: linear-gradient(0deg, rgba(201, 169, 97, 0.1), transparent);
      transition: height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .experience-item:hover {
      border-color: rgba(201, 169, 97, 0.2);
      transform: translateY(-8px);
      background: rgba(20, 20, 25, 0.7);
    }

    .experience-item:hover::before {
      height: 100%;
    }

    .experience-icon {
      font-size: 3rem;
      margin-bottom: 1.5rem;
      opacity: 0.9;
      position: relative;
      z-index: 1;
    }

    .experience-item h3 {
      font-family: var(--font-primary);
      font-size: 1.4rem;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.95);
      margin-bottom: 1rem;
      letter-spacing: 0.5px;
      position: relative;
      z-index: 1;
    }

    .experience-item p {
      font-family: var(--font-secondary);
      font-weight: 300;
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.65);
      line-height: 1.7;
      letter-spacing: 0.3px;
      position: relative;
      z-index: 1;
    }

    /* Activities Section */
    .activities-section {
      padding: 8rem 0;
      background: #0a0a0f;
      position: relative;
      overflow: hidden;
    }

    .activities-video-bg {
      position: absolute;
      top: 50%;
      left: 50%;
      min-width: 100%;
      min-height: 100%;
      width: auto;
      height: auto;
      transform: translate(-50%, -50%);
      z-index: 0;
      opacity: 0.3;
      object-fit: cover;
      /* Mejorar calidad de renderizado del video */
      image-rendering: -webkit-optimize-contrast;
      image-rendering: crisp-edges;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      transform-style: preserve-3d;
      -webkit-transform-style: preserve-3d;
      will-change: transform;
    }

    .activities-section .container {
      position: relative;
      z-index: 1;
    }

    .activities-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.1),
        transparent
      );
    }

    .activities-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
      margin-top: var(--spacing-lg);
    }

    .activity-card {
      background: rgba(15, 15, 20, 0.6);
      backdrop-filter: blur(20px);
      padding: 2rem;
      border-radius: 16px;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-left: 2px solid transparent;
      position: relative;
      overflow: hidden;
    }

    .activity-card::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0;
      bottom: 0;
      width: 0;
      background: linear-gradient(180deg, #c9a961, transparent);
      transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .activity-card:hover {
      transform: translateY(-6px);
      border-color: rgba(201, 169, 97, 0.2);
      border-left-color: #c9a961;
      background: rgba(20, 20, 25, 0.7);
    }

    .activity-card:hover::before {
      width: 2px;
    }

    .activity-icon {
      font-size: 2.5rem;
      margin-bottom: 1.25rem;
      opacity: 0.9;
      position: relative;
      z-index: 1;
    }

    .activity-card h3 {
      font-family: var(--font-primary);
      font-size: 1.3rem;
      font-weight: 400;
      color: rgba(255, 255, 255, 0.95);
      margin-bottom: 0.75rem;
      letter-spacing: 0.5px;
      position: relative;
      z-index: 1;
    }

    .activity-card p {
      font-family: var(--font-secondary);
      font-size: 0.95rem;
      font-weight: 300;
      line-height: 1.7;
      color: rgba(255, 255, 255, 0.65);
      letter-spacing: 0.3px;
      position: relative;
      z-index: 1;
    }

    /* CTA Mini Section */
    .cta-mini-section {
      padding: 8rem 0;
      background: rgba(15, 15, 20, 0.5);
      position: relative;
      overflow: hidden;
    }

    .cta-mini-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.1),
        transparent
      );
    }

    .cta-mini-section::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 600px;
      height: 600px;
      background: radial-gradient(
        circle,
        rgba(201, 169, 97, 0.08) 0%,
        transparent 70%
      );
      pointer-events: none;
    }

    .cta-mini-content {
      text-align: center;
      max-width: 800px;
      margin: 0 auto;
      padding: 3rem;
      position: relative;
      z-index: 1;
    }

    .cta-mini-title {
      font-family: var(--font-primary);
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 300;
      color: rgba(255, 255, 255, 0.95);
      margin-bottom: 1.5rem;
      line-height: 1.3;
      letter-spacing: 1px;
    }

    .cta-mini-text {
      font-family: var(--font-secondary);
      font-size: clamp(1rem, 2vw, 1.15rem);
      font-weight: 300;
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 3rem;
      line-height: 1.8;
      letter-spacing: 0.3px;
    }

    .cta-mini-button {
      display: inline-flex;
      align-items: center;
      gap: 1rem;
      background: linear-gradient(135deg, #c9a961 0%, #b8944e 100%);
      color: #0a0a0f;
      padding: 1.25rem 3rem;
      border-radius: 4px;
      text-decoration: none;
      font-size: 1rem;
      font-weight: 400;
      letter-spacing: 1px;
      text-transform: uppercase;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 8px 32px rgba(201, 169, 97, 0.3);
      border: 1px solid #c9a961;
      position: relative;
      overflow: hidden;
    }

    .cta-mini-button::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.2),
        transparent
      );
      transition: left 0.6s ease;
    }

    .cta-mini-button:hover::before {
      left: 100%;
    }

    .cta-mini-button:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 48px rgba(201, 169, 97, 0.5);
      background: linear-gradient(135deg, #d4b66d 0%, #c9a961 100%);
    }

    .cta-mini-button .arrow {
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      font-size: 1.2rem;
    }

    .cta-mini-button:hover .arrow {
      transform: translateX(6px);
    }

    /* Itinerary Section */
    .itinerary-section {
      padding: 8rem 0;
      background: #0a0a0f;
      position: relative;
    }

    .itinerary-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.1),
        transparent
      );
    }

    /* Schedule Cards */
    .schedule-cards {
      margin-top: var(--spacing-lg);
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
    }

    .schedule-card {
      background: rgba(15, 15, 20, 0.6);
      backdrop-filter: blur(20px);
      border-radius: 20px;
      padding: 3rem 2.5rem;
      border: 1px solid rgba(255, 255, 255, 0.06);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      text-align: center;
      position: relative;
      overflow: hidden;
    }

    .schedule-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(201, 169, 97, 0.6),
        transparent
      );
    }

    .schedule-card:hover {
      transform: translateY(-8px);
      border-color: rgba(201, 169, 97, 0.3);
      box-shadow:
        0 25px 60px rgba(0, 0, 0, 0.5),
        0 0 40px rgba(201, 169, 97, 0.1);
    }

    .schedule-icon {
      font-size: 3.5rem;
      margin-bottom: 1.5rem;
      display: block;
    }

    .schedule-label {
      display: block;
      font-family: var(--font-secondary);
      font-size: 0.8rem;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: rgba(201, 169, 97, 0.9);
      font-weight: 500;
      margin-bottom: 0.5rem;
    }

    .schedule-title {
      font-family: var(--font-primary);
      font-size: clamp(2rem, 3vw, 2.5rem);
      font-weight: 400;
      color: rgba(255, 255, 255, 0.95);
      margin-bottom: 0.75rem;
      letter-spacing: 1px;
    }

    .schedule-time {
      font-family: var(--font-secondary);
      font-size: 1.3rem;
      color: #c9a961;
      font-weight: 500;
      margin-bottom: 1.5rem;
      letter-spacing: 0.5px;
    }

    .schedule-description {
      font-family: var(--font-secondary);
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.7);
      line-height: 1.7;
      font-weight: 300;
    }

    .schedule-note {
      margin-top: 3rem;
      text-align: center;
      font-family: var(--font-secondary);
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.6);
      font-style: italic;
      line-height: 1.8;
      max-width: 700px;
      margin-left: auto;
      margin-right: auto;
    }

    @media (max-width: 768px) {
      .schedule-cards {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .schedule-card {
        padding: 2.5rem 2rem;
      }

      .schedule-icon {
        font-size: 3rem;
      }
    }

    /* Testimonials Section */
    .testimonials-section {
      padding: 8rem 0;
      background: #0a0a0f;
      position: relative;
      overflow: hidden;
      min-height: 100vh;
    }

    .testimonials-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.1),
        transparent
      );
    }

    .testimonials-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      pointer-events: none;
    }

    .floating-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      opacity: 0.3;
      animation: float-orb 20s ease-in-out infinite;
    }

    .orb-1 {
      width: 400px;
      height: 400px;
      background: radial-gradient(
        circle,
        rgba(201, 169, 97, 0.08) 0%,
        transparent 70%
      );
      top: -100px;
      left: -100px;
      animation-delay: 0s;
    }

    .orb-2 {
      width: 500px;
      height: 500px;
      background: radial-gradient(
        circle,
        rgba(201, 169, 97, 0.1) 0%,
        transparent 70%
      );
      bottom: -150px;
      right: -150px;
      animation-delay: 5s;
    }

    .orb-3 {
      width: 350px;
      height: 350px;
      background: radial-gradient(
        circle,
        rgba(201, 169, 97, 0.06) 0%,
        transparent 70%
      );
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      animation-delay: 10s;
    }

    @keyframes float-orb {
      0%,
      100% {
        transform: translate(0, 0) scale(1);
      }
      33% {
        transform: translate(100px, -100px) scale(1.1);
      }
      66% {
        transform: translate(-50px, 100px) scale(0.9);
      }
    }

    .testimonials-header {
      text-align: center;
      margin-bottom: var(--spacing-xl);
      position: relative;
      z-index: 2;
    }

    .testimonial-label {
      display: inline-block;
      font-family: var(--font-secondary);
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: rgba(201, 169, 97, 0.8);
      margin-bottom: var(--spacing-sm);
      font-weight: 400;
    }

    .testimonials-title {
      font-family: var(--font-primary);
      font-size: clamp(2.5rem, 6vw, 4rem);
      font-weight: 300;
      color: rgba(255, 255, 255, 0.95);
      margin-bottom: var(--spacing-md);
      line-height: 1.2;
      letter-spacing: 1px;
    }

    .testimonials-subtitle {
      font-family: var(--font-secondary);
      font-size: 1.15rem;
      font-weight: 300;
      color: rgba(255, 255, 255, 0.7);
      font-style: italic;
      letter-spacing: 0.5px;
    }

    /* Video Testimonials */
    .video-testimonials {
      margin-bottom: var(--spacing-xl);
      position: relative;
      z-index: 2;
    }

    .video-featured {
      margin-bottom: var(--spacing-lg);
    }

    .video-card {
      position: relative;
      border-radius: 25px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      background: rgba(0, 0, 0, 0.4);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .video-card:hover {
      transform: translateY(-10px) scale(1.02);
      box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.6),
        0 0 40px rgba(201, 169, 97, 0.3);
      border-color: var(--color-accent);
    }

    .video-wrapper {
      position: relative;
      padding-bottom: 56.25%; /* 16:9 Aspect Ratio */
      height: 0;
      overflow: hidden;
    }

    .video-overlay {
      position: absolute;
      top: 20px;
      left: 20px;
      z-index: 10;
    }

    .video-badge {
      display: inline-block;
      padding: 0.5rem 1rem;
      background: rgba(201, 169, 97, 0.9);
      backdrop-filter: blur(10px);
      color: var(--color-white);
      border-radius: 50px;
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
    }

    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--spacing-md);
    }

    .video-small .video-wrapper {
      padding-bottom: 75%; /* 4:3 for smaller videos */
    }

    /* Text Testimonials */
    .text-testimonials {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: var(--spacing-lg);
      margin-bottom: var(--spacing-xl);
      position: relative;
      z-index: 2;
    }

    .testimonial-card {
      position: relative;
      background: linear-gradient(
        135deg,
        rgba(255, 255, 255, 0.08) 0%,
        rgba(255, 255, 255, 0.03) 100%
      );
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      border-radius: 30px;
      padding: var(--spacing-lg);
      transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
      overflow: hidden;
      cursor: pointer;
    }

    .testimonial-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(
        135deg,
        rgba(74, 144, 164, 0.1) 0%,
        rgba(201, 169, 97, 0.1) 100%
      );
      opacity: 0;
      transition: opacity 0.6s ease;
      z-index: 0;
    }

    .testimonial-card:hover {
      transform: translateY(-15px) scale(1.03);
      border-color: var(--color-accent);
      box-shadow:
        0 25px 70px rgba(0, 0, 0, 0.6),
        0 0 50px rgba(201, 169, 97, 0.25),
        inset 0 1px 0 rgba(255, 255, 255, 0.3);
    }

    .testimonial-card:hover::before {
      opacity: 1;
    }

    .testimonial-glow {
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(
        circle,
        rgba(201, 169, 97, 0.2) 0%,
        transparent 70%
      );
      opacity: 0;
      transition: opacity 0.6s ease;
      pointer-events: none;
      animation: rotate-glow 8s linear infinite;
    }

    .testimonial-card:hover .testimonial-glow {
      opacity: 1;
    }

    .quote-icon {
      position: absolute;
      top: 20px;
      right: 30px;
      font-size: 6rem;
      color: rgba(201, 169, 97, 0.15);
      font-family: Georgia, serif;
      line-height: 1;
      z-index: 0;
      transition: all 0.6s ease;
    }

    .testimonial-card:hover .quote-icon {
      color: rgba(201, 169, 97, 0.25);
      transform: scale(1.2) rotate(5deg);
    }

    .testimonial-content {
      position: relative;
      z-index: 2;
    }

    .testimonial-text {
      font-size: 1.05rem;
      line-height: 1.9;
      color: rgba(255, 255, 255, 0.95);
      margin-bottom: var(--spacing-lg);
      font-style: italic;
    }

    .testimonial-author {
      display: flex;
      align-items: center;
      gap: var(--spacing-md);
      padding-top: var(--spacing-md);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }

    .author-avatar {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background: linear-gradient(
        135deg,
        var(--color-primary),
        var(--color-accent)
      );
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--color-white);
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);
      transition: all 0.3s ease;
    }

    .testimonial-card:hover .author-avatar {
      transform: scale(1.1) rotate(5deg);
      box-shadow: 0 8px 30px rgba(201, 169, 97, 0.5);
    }

    .author-info {
      flex: 1;
    }

    .author-name {
      font-size: 1.1rem;
      color: var(--color-white);
      font-weight: 600;
      margin-bottom: 0.25rem;
    }

    .author-location {
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.6);
    }

    /* Staggered animations for testimonials */
    .testimonial-card {
      opacity: 0;
      animation: fadeInScale 0.8s ease forwards;
    }

    .testimonial-1 {
      animation-delay: 0.1s;
    }
    .testimonial-2 {
      animation-delay: 0.2s;
    }
    .testimonial-3 {
      animation-delay: 0.3s;
    }
    .testimonial-4 {
      animation-delay: 0.4s;
    }
    .testimonial-5 {
      animation-delay: 0.5s;
    }
    .testimonial-6 {
      animation-delay: 0.6s;
    }

    /* Testimonials CTA */
    .testimonials-cta {
      text-align: center;
      margin-top: var(--spacing-xl);
      padding: var(--spacing-lg);
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px);
      border-radius: 30px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      position: relative;
      z-index: 2;
    }

    .cta-text {
      font-size: 1.5rem;
      color: var(--color-white);
      margin-bottom: var(--spacing-md);
      font-family: var(--font-primary);
    }

    .cta-button-testimonials {
      display: inline-block;
      padding: 1.2rem 3rem;
      background: linear-gradient(135deg, var(--color-accent) 0%, #d4b970 100%);
      color: var(--color-white);
      text-decoration: none;
      border-radius: 50px;
      font-size: 1.2rem;
      font-weight: 600;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 10px 40px rgba(201, 169, 97, 0.4);
      position: relative;
      overflow: hidden;
    }

    .cta-button-testimonials::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.3),
        transparent
      );
      transition: left 0.5s ease;
    }

    .cta-button-testimonials:hover::before {
      left: 100%;
    }

    .cta-button-testimonials:hover {
      transform: translateY(-5px) scale(1.05);
      box-shadow: 0 20px 60px rgba(201, 169, 97, 0.6);
    }

    /* Responsive for testimonials */
    @media (max-width: 768px) {
      .text-testimonials {
        grid-template-columns: 1fr;
        gap: var(--spacing-md);
      }

      .video-grid {
        grid-template-columns: 1fr;
      }

      .testimonial-text {
        font-size: 1rem;
      }

      .quote-icon {
        font-size: 4rem;
        top: 15px;
        right: 20px;
      }

      .cta-text {
        font-size: 1.2rem;
      }

      .cta-button-testimonials {
        padding: 1rem 2rem;
        font-size: 1rem;
      }

      .orb-1,
      .orb-2,
      .orb-3 {
        opacity: 0.2;
      }
    }

    /* Why Attend Section */
    .why-attend-section {
      padding: 8rem 0;
      background: rgba(15, 15, 20, 0.5);
      position: relative;
      overflow: hidden;
    }

    .why-attend-video-bg {
      position: absolute;
      top: 50%;
      left: 50%;
      min-width: 100%;
      min-height: 100%;
      width: auto;
      height: auto;
      transform: translate(-50%, -50%);
      z-index: 0;
      opacity: 0.3;
      object-fit: cover;
      /* Mejorar calidad de renderizado del video */
      image-rendering: -webkit-optimize-contrast;
      image-rendering: crisp-edges;
      backface-visibility: hidden;
      -webkit-backface-visibility: hidden;
      transform-style: preserve-3d;
      -webkit-transform-style: preserve-3d;
      will-change: transform;
    }

    .why-attend-section .container {
      position: relative;
      z-index: 1;
    }

    .why-attend-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.1),
        transparent
      );
    }

    .why-attend-section::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 1000px;
      height: 1000px;
      background: radial-gradient(
        circle,
        rgba(201, 169, 97, 0.05) 0%,
        transparent 70%
      );
      pointer-events: none;
    }

    .why-attend-header {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 2rem;
      margin-bottom: var(--spacing-xl);
      position: relative;
    }

    .decorative-line {
      height: 1px;
      width: 100px;
      background: linear-gradient(
        to right,
        transparent,
        var(--color-accent),
        transparent
      );
      animation: pulse-line 2s ease-in-out infinite;
    }

    @keyframes pulse-line {
      0%,
      100% {
        opacity: 0.5;
        transform: scaleX(1);
      }
      50% {
        opacity: 1;
        transform: scaleX(1.2);
      }
    }

    .why-attend-title {
      font-family: var(--font-primary);
      font-size: clamp(2.5rem, 5vw, 3.8rem);
      font-weight: 300;
      color: rgba(255, 255, 255, 0.95);
      text-align: center;
      letter-spacing: 1px;
      position: relative;
    }

    .why-attend-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
      gap: var(--spacing-lg);
      margin-top: var(--spacing-xl);
      position: relative;
    }

    .why-card {
      background: rgba(15, 15, 20, 0.6);
      backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      padding: 3rem;
      position: relative;
      overflow: hidden;
      transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
      cursor: pointer;
    }

    .why-card::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: linear-gradient(
        135deg,
        rgba(74, 144, 164, 0.1) 0%,
        rgba(201, 169, 97, 0.1) 100%
      );
      opacity: 0;
      transition: opacity 0.5s ease;
    }

    .why-card:hover {
      transform: translateY(-8px);
      border-color: rgba(201, 169, 97, 0.2);
      background: rgba(20, 20, 25, 0.7);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    }

    .why-card:hover::before {
      opacity: 1;
    }

    .card-glow {
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(
        circle,
        rgba(201, 169, 97, 0.15) 0%,
        transparent 70%
      );
      opacity: 0;
      transition: opacity 0.5s ease;
      pointer-events: none;
    }

    .why-card:hover .card-glow {
      opacity: 1;
      animation: rotate-glow 4s linear infinite;
    }

    @keyframes rotate-glow {
      0% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(360deg);
      }
    }

    .card-number {
      position: absolute;
      top: -20px;
      right: 20px;
      font-size: 6rem;
      font-weight: 700;
      color: rgba(201, 169, 97, 0.1);
      font-family: var(--font-primary);
      line-height: 1;
      transition: all 0.5s ease;
      z-index: 0;
    }

    .why-card:hover .card-number {
      color: rgba(201, 169, 97, 0.2);
      transform: scale(1.1);
    }

    .card-content {
      position: relative;
      z-index: 2;
    }

    .card-icon-large {
      font-size: 4rem;
      margin-bottom: var(--spacing-md);
      filter: drop-shadow(0 0 20px rgba(201, 169, 97, 0.3));
      animation: float-icon 3s ease-in-out infinite;
    }

    @keyframes float-icon {
      0%,
      100% {
        transform: translateY(0) rotate(0deg);
      }
      50% {
        transform: translateY(-15px) rotate(5deg);
      }
    }

    .why-card:hover .card-icon-large {
      animation: float-icon-hover 1s ease-in-out infinite;
    }

    @keyframes float-icon-hover {
      0%,
      100% {
        transform: translateY(0) scale(1) rotate(0deg);
      }
      50% {
        transform: translateY(-10px) scale(1.1) rotate(-5deg);
      }
    }

    .card-content p {
      font-family: var(--font-secondary);
      color: rgba(255, 255, 255, 0.7);
      font-size: 1.05rem;
      font-weight: 300;
      line-height: 1.9;
      letter-spacing: 0.3px;
      position: relative;
    }

    .card-content strong {
      color: rgba(255, 255, 255, 0.95);
      font-weight: 400;
    }

    /* Staggered animation on scroll */
    .why-card {
      opacity: 0;
      animation: fadeInScale 0.8s ease forwards;
    }

    .card-1 {
      animation-delay: 0.1s;
    }
    .card-2 {
      animation-delay: 0.2s;
    }
    .card-3 {
      animation-delay: 0.3s;
    }
    .card-4 {
      animation-delay: 0.4s;
    }
    .card-5 {
      animation-delay: 0.5s;
    }
    .card-6 {
      animation-delay: 0.6s;
    }

    @keyframes fadeInScale {
      from {
        opacity: 0;
        transform: scale(0.9) translateY(30px);
      }
      to {
        opacity: 1;
        transform: scale(1) translateY(0);
      }
    }

    /* Message Section */
    .message-section {
      padding: 8rem 0;
      background: rgba(15, 15, 20, 0.5);
      color: rgba(255, 255, 255, 0.95);
      text-align: center;
      position: relative;
    }

    .message-section::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.1),
        transparent
      );
    }

    .message-content {
      max-width: 900px;
      margin: 0 auto;
    }

    .message-title {
      font-family: var(--font-primary);
      font-size: clamp(2.5rem, 5vw, 3.5rem);
      font-weight: 300;
      margin-bottom: 2rem;
      line-height: 1.4;
      letter-spacing: 1px;
    }

    .message-text {
      font-family: var(--font-secondary);
      font-size: 1.2rem;
      font-weight: 300;
      margin-bottom: 1.5rem;
      line-height: 1.9;
      color: rgba(255, 255, 255, 0.75);
      letter-spacing: 0.3px;
    }

    .message-highlight {
      font-family: var(--font-secondary);
      font-size: 1.3rem;
      font-style: italic;
      font-weight: 300;
      line-height: 1.9;
      color: rgba(255, 255, 255, 0.8);
    }

    .benefits-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 1.5rem;
      margin-top: 4rem;
    }

    .benefit-item {
      background: rgba(15, 15, 20, 0.6);
      backdrop-filter: blur(20px);
      padding: 2rem;
      border-radius: 16px;
      font-family: var(--font-secondary);
      font-size: 1.05rem;
      font-weight: 300;
      text-align: center;
      border: 1px solid rgba(255, 255, 255, 0.06);
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      color: rgba(255, 255, 255, 0.85);
      letter-spacing: 0.3px;
    }

    .benefit-item:hover {
      background: rgba(20, 20, 25, 0.7);
      border-color: rgba(201, 169, 97, 0.2);
      transform: translateY(-6px);
      color: rgba(255, 255, 255, 0.95);
    }

    /* FAQ Section */
    .faq-section {
      padding: var(--spacing-xl) 0;
      background: var(--color-light);
    }

    .faq-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: var(--spacing-md);
      margin-top: var(--spacing-lg);
    }

    .faq-item {
      background: var(--color-white);
      padding: var(--spacing-md);
      border-radius: 15px;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.08);
      transition: all 0.3s ease;
    }

    .faq-item:hover {
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
      transform: translateY(-3px);
    }

    .faq-question {
      font-size: 1.1rem;
      color: var(--color-primary);
      margin-bottom: var(--spacing-sm);
      font-weight: 600;
    }

    .faq-answer {
      font-size: 1rem;
      color: #666;
      line-height: 1.6;
    }

    /* Location Section */
    .location-section {
      padding: var(--spacing-xl) 0;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: var(--color-white);
    }

    .location-content {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
      gap: var(--spacing-lg);
      margin-top: var(--spacing-lg);
      align-items: start;
    }

    .location-info {
      padding: var(--spacing-md);
    }

    .location-subtitle {
      font-family: var(--font-primary);
      font-size: clamp(1.5rem, 3vw, 2rem);
      margin-bottom: var(--spacing-md);
      color: var(--color-accent);
    }

    .location-description {
      font-size: 1.1rem;
      line-height: 1.8;
      margin-bottom: var(--spacing-lg);
    }

    .location-feature {
      display: flex;
      gap: var(--spacing-md);
      margin-bottom: var(--spacing-lg);
      background: rgba(255, 255, 255, 0.1);
      padding: var(--spacing-md);
      border-radius: 15px;
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      transition: all 0.3s ease;
    }

    .location-feature:hover {
      background: rgba(255, 255, 255, 0.15);
      transform: translateX(10px);
    }

    .feature-icon {
      font-size: 2.5rem;
      flex-shrink: 0;
    }

    .feature-content h4 {
      font-size: 1.2rem;
      margin-bottom: var(--spacing-xs);
      color: var(--color-accent);
    }

    .feature-content p {
      font-size: 1rem;
      line-height: 1.6;
    }

    .location-map {
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      transition: all 0.3s ease;
    }

    .location-map:hover {
      box-shadow: 0 25px 80px rgba(0, 0, 0, 0.4);
      transform: scale(1.02);
    }

    .map-link {
      display: inline-block;
      margin-top: var(--spacing-md);
      padding: var(--spacing-sm) var(--spacing-md);
      background: var(--color-accent);
      color: var(--color-white);
      text-decoration: none;
      border-radius: 50px;
      font-weight: 600;
      transition: all 0.3s ease;
      box-shadow: 0 5px 20px rgba(0, 0, 0, 0.2);
    }

    .map-link:hover {
      background: #d4b970;
      transform: translateY(-3px);
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.3);
    }

    /* Final CTA */
    .final-cta {
      padding: 10rem 0;
      background: #0a0a0f;
      color: rgba(255, 255, 255, 0.95);
      text-align: center;
      position: relative;
    }

    .final-cta::before {
      content: "";
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: 80%;
      max-width: 600px;
      height: 1px;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.1),
        transparent
      );
    }

    .final-cta::after {
      content: "";
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 800px;
      height: 800px;
      background: radial-gradient(
        circle,
        rgba(201, 169, 97, 0.05) 0%,
        transparent 70%
      );
      pointer-events: none;
    }

    .cta-content {
      max-width: 800px;
      margin: 0 auto;
      position: relative;
      z-index: 1;
    }

    .cta-title {
      font-family: var(--font-primary);
      font-size: clamp(2.5rem, 5vw, 4rem);
      font-weight: 300;
      margin-bottom: 1.5rem;
      letter-spacing: 1px;
      line-height: 1.2;
    }

    .cta-subtitle {
      font-family: var(--font-secondary);
      font-size: 1.2rem;
      font-weight: 300;
      margin-bottom: 1.75rem;
      color: rgba(201, 169, 97, 0.9);
      letter-spacing: 2px;
      text-transform: uppercase;
    }

    .cta-soldout {
      display: flex;
      justify-content: center;
      margin-bottom: 2.5rem;
    }

    .cta-button-large {
      display: inline-block;
      background: linear-gradient(135deg, #c9a961 0%, #b8944e 100%);
      color: #0a0a0f;
      padding: 1.5rem 4rem;
      border-radius: 4px;
      text-decoration: none;
      font-size: 1.1rem;
      font-weight: 400;
      letter-spacing: 2px;
      text-transform: uppercase;
      transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
      box-shadow: 0 8px 32px rgba(201, 169, 97, 0.3);
      margin-bottom: 2rem;
      border: 1px solid #c9a961;
      position: relative;
      overflow: hidden;
    }

    .cta-button-large::before {
      content: "";
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(
        90deg,
        transparent,
        rgba(255, 255, 255, 0.3),
        transparent
      );
      transition: left 0.6s ease;
    }

    .cta-button-large:hover::before {
      left: 100%;
    }

    .cta-button-large:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 48px rgba(201, 169, 97, 0.5);
      background: linear-gradient(135deg, #d4b66d 0%, #c9a961 100%);
    }

    .cta-note {
      font-family: var(--font-secondary);
      font-size: 1rem;
      font-weight: 300;
      color: rgba(255, 255, 255, 0.6);
      letter-spacing: 0.5px;
    }

    /* Responsive */
    @media (max-width: 1200px) {
      .hero-content {
        padding: 7rem var(--spacing-md) var(--spacing-lg);
      }

      .container {
        max-width: 100%;
      }

      .purpose-content,
      .approach-grid,
      .experience-grid,
      .activities-grid {
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      }
    }

    @media (max-width: 768px) {
      .navbar-menu {
        position: fixed;
        top: 70px;
        left: 0;
        width: 100%;
        background: rgba(10, 10, 15, 0.98);
        backdrop-filter: blur(20px);
        flex-direction: column;
        padding: 2rem;
        gap: 1.5rem;
        transform: translateX(-100%);
        transition: transform 0.3s ease;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }

      .navbar-menu.active {
