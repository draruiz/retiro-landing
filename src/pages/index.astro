---
import Layout from "../layouts/Layout.astro";
import Footer from "../components/Footer.astro";
import RetreatFormModal from "../components/RetreatFormModal.astro";
import SoldOutBadge from "../components/SoldOutBadge.astro";
import backgroundStars from "../assets/backgorund.png";
import mainLogo from "../assets/main_logo_brain.png";
import docAlejandra from "../assets/doc_alejandra-perfil_whatsapp.jpeg";
import bosqueRioDeOro from "../assets/bosque_1_rio_de_oro.jpg";
import bosque2RioDeOro from "../assets/bosque_2_rio_de_oro.jpg";
import LocationShowcase from "../components/LocationShowcase.astro";
import porqueIrVideo from "../assets/video/porque_ir.mp4";
import actividadesPrincipalesVideo from "../assets/video/actividades_principales.mp4";
import videoTulum1 from "../assets/video/video_tulum_1.mp4";
import videoTulum2 from "../assets/video/video_tulum_2.mp4";
import videoTulum3 from "../assets/video/video_tulum_3.mp4";
---

<Layout>
  <!-- Navbar -->
  <nav class='navbar' id='navbar'>
    <div class='navbar-container'>
      <div class='navbar-logo'>
        <img src={mainLogo.src} alt='CALMA Logo' class='navbar-logo-img' />
        <span class='navbar-brand'>CALMA</span>
      </div>

      <button class='navbar-toggle' id='navbarToggle' aria-label='Toggle menu'>
        <span class='hamburger-line'></span>
        <span class='hamburger-line'></span>
        <span class='hamburger-line'></span>
      </button>

      <div class='navbar-menu' id='navbarMenu'>
        <a href='#inicio' class='navbar-link'>Inicio</a>
        <a href='#proposito' class='navbar-link'>Propósito</a>
        <a href='#actividades' class='navbar-link'>Actividades</a>
        <a href='#itinerario' class='navbar-link'>Horarios</a>
        <a href='/ubicacion' class='navbar-link'>Ubicación</a>
        <a href='/faq' class='navbar-link'>FAQ</a>
        <a
          href='https://transforma-tu-interior.almaymente.io'
          target='_blank'
          rel='noopener noreferrer'
          class='navbar-link navbar-cta'>Ver Próximo Retiro</a
        >
      </div>
    </div>
  </nav>

  <main class='retiro-landing'>
    <!-- Hero Section -->
    <section class='hero' id='inicio'>
      <div class='hero-bg-wrapper'>
        <div
          class='hero-bg'
          id='hero-bg'
          style={`background-image: url(${backgroundStars.src})`}
        >
          <div class='hero-overlay'></div>
        </div>
      </div>
      <div class='container hero-content'>
        <div class='logo-perspective'>
          <div class='logo-container' id='logo-container'>
            <div class='logo-glow'></div>
            <img src={mainLogo.src} alt='CALMA Logo' class='main-logo' />
          </div>
        </div>
        <h1 class='hero-title'>
          <span class='reveal-wrapper'>
            <span class='title-main reveal-text'>CALMA</span>
          </span>
          <span class='reveal-wrapper'>
            <span class='title-subtitle reveal-text delay-1'>
              El Retiro para Soltar y Renacer
            </span>
          </span>
        </h1>
        <div class='description-wrapper'>
          <p class='hero-description reveal-opacity delay-2'>
            Un encuentro para soltar lo que pesa y volver a habitar<br />tu alma
            en calma.
          </p>
        </div>
        <div class='hero-dates reveal-opacity delay-3'>
          <span class='date-badge'>📅 Noviembre de 2026</span>
        </div>

        <div class='hero-soldout reveal-opacity delay-3'>
          <SoldOutBadge
            variant='hero'
            label='Cupos Agotados'
            note='Este retiro ya está completo. Descubre nuestra próxima experiencia.'
          />
        </div>

        <div class='cta-wrapper reveal-opacity delay-4'>
          <a
            href='https://transforma-tu-interior.almaymente.io'
            target='_blank'
            rel='noopener noreferrer'
            class='cta-button'
          >
            Ver Próximo Retiro
          </a>
        </div>
      </div>
    </section>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const heroBg = document.getElementById("hero-bg");
        const isTouchDevice = window.matchMedia("(pointer: coarse)").matches;

        // Simple Scroll Parallax (disabled on touch devices for smooth scrolling)
        if (!isTouchDevice && heroBg) {
          window.addEventListener(
            "scroll",
            () => {
              const scrolled = window.scrollY;
              if (scrolled < window.innerHeight) {
                heroBg.style.transform = `translateY(${scrolled * 0.5}px)`;
              }
            },
            { passive: true },
          );
        }
      });
    </script>

    <!-- Location Showcase Section -->
    <LocationShowcase />

    <!-- Propósito Section -->
    <section
      class='purpose-section'
      id='proposito'
      style={`background: linear-gradient(rgba(10, 10, 15, 0.85), rgba(10, 10, 15, 0.85)), url(${bosqueRioDeOro.src}); background-size: cover; background-position: center; background-attachment: scroll;`}
    >
      <div class='container'>
        <div class='section-header'>
          <h2 class='section-title'>La pausa que tu alma estaba pidiendo</h2>
          <div class='title-underline'></div>
        </div>
        <div class='purpose-content'>
          <div class='purpose-card float-animation'>
            <div class='card-icon'>🕊️</div>
            <p class='purpose-text'>
              Este retiro nace para quienes necesitan un respiro, un lugar donde
              por fin puedan
              <strong>soltar la angustia</strong>, apagar el ruido mental y
              volver a sentirse en paz.
            </p>
          </div>
          <div class='purpose-card float-animation-delay'>
            <div class='card-icon'>🌿</div>
            <p class='purpose-text'>
              En CALMA aprenderás a reencontrarte con tu tranquilidad interior,
              a manejar pensamientos obsesivos y ansiedad, a sanar tus heridas
              más profundas y a reencontrarte con la alegría que habita dentro
              de ti… incluso si llevas tiempo sin sentirla.
            </p>
          </div>
          <div class='purpose-card float-animation'>
            <div class='card-icon'>✨</div>
            <p class='purpose-text'>
              Es un <strong>regalo para tu mente</strong>. Un descanso para tu
              alma. Un renacer para tu vida.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Qué es CALMA Section -->
    <section class='facilitator-section'>
      <div class='container'>
        <div
          class='section-header'
          style='text-align: center; margin-bottom: 3rem;'
        >
          <h2 class='section-title' style='color: white;'>¿Qué es CALMA?</h2>
          <div
            class='title-underline'
            style='background: linear-gradient(to right, rgba(255,255,255,0.8), rgba(201,169,97,0.8));'
          >
          </div>
        </div>
        <div class='facilitator-content'>
          <div class='facilitator-image'>
            <img
              src={docAlejandra.src}
              alt='Dra. María Alejandra Ruiz'
              class='doctor-photo'
            />
          </div>
          <div class='facilitator-info'>
            <h3 class='facilitator-label'>Creado y dirigido por</h3>
            <h2 class='facilitator-name'>Dra. María Alejandra Ruiz</h2>
            <p class='facilitator-title'>Psicóloga Clínica</p>
            <p class='facilitator-description'>
              Autora del libro <em
                >'El niño que fui y el adulto que elijo ser'</em
              >.
            </p>
            <p class='facilitator-description' style='margin-top: 1rem;'>
              Un retiro terapéutico–espiritual que combina <strong
                >psicología, espiritualidad y naturaleza</strong
              >. Durante tres días vivirás una experiencia transformadora que
              integra ciencia y consciencia.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Enfoque Section -->
    <section
      class='investment-section'
      style={`background: linear-gradient(rgba(10, 10, 15, 0.85), rgba(10, 10, 15, 0.85)), url(${bosque2RioDeOro.src}); background-size: cover; background-position: center; background-attachment: scroll;`}
    >
      <div class='container'>
        <div class='approach-grid'>
          <div class='approach-column'>
            <h3 class='approach-title'>🧠 Psicología basada en evidencia</h3>
            <ul class='approach-list'>
              <li>Terapia Cognitivo-Conductual</li>
              <li>DBT (Terapia Dialéctico Conductual)</li>
              <li>Regulación emocional</li>
              <li>Reestructuración de pensamientos</li>
              <li>Trabajo profundo de heridas de rechazo y abandono</li>
              <li>Roleplay y ejercicios vivenciales</li>
            </ul>
          </div>
          <div class='approach-column'>
            <h3 class='approach-title'>
              🌸 Prácticas holísticas y de conexión interior
            </h3>
            <ul class='approach-list'>
              <li>Ritual Guardián del Agua</li>
              <li>Conexión con la naturaleza</li>
              <li>Masajes con piedras volcánicas</li>
              <li>Reiki y alineación de chakras</li>
              <li>Terapia floral y de sonido con cuencos</li>
              <li>Caminata meditativa en el bosque</li>
              <li>Fogata y ritual de liberación</li>
              <li>Noche de alegría y música en vivo</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Para Quién Section -->
    <section class='experience-section'>
      <div class='container'>
        <div class='section-header'>
          <h2 class='section-title'>¿Para quién es este retiro?</h2>
          <div class='title-underline'></div>
        </div>
        <div class='experience-grid'>
          <div class='experience-item'>
            <div class='experience-icon'>😰</div>
            <h3>Ansiedad y sobrecarga mental</h3>
            <p>
              Personas con ansiedad, angustia o mente hiperactiva que necesitan
              paz.
            </p>
          </div>
          <div class='experience-item'>
            <div class='experience-icon'>💔</div>
            <h3>Rupturas y duelos</h3>
            <p>
              Quienes están pasando por separaciones, pérdidas o vínculos
              confusos.
            </p>
          </div>
          <div class='experience-item'>
            <div class='experience-icon'>🌪️</div>
            <h3>Necesidad de descanso</h3>
            <p>Quienes necesitan un respiro del ruido externo e interno.</p>
          </div>
          <div class='experience-item'>
            <div class='experience-icon'>💚</div>
            <h3>Heridas emocionales</h3>
            <p>Personas con heridas de rechazo y abandono que desean sanar.</p>
          </div>
          <div class='experience-item'>
            <div class='experience-icon'>🦋</div>
            <h3>Reconexión interior</h3>
            <p>Quienes desean reconectar con su alegría, calma y centro.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Actividades Principales Section -->
    <section class='activities-section' id='actividades'>
      <video
        autoplay
        muted
        loop
        playsinline
        class='activities-video-bg'
        preload='auto'
      >
        <source src={actividadesPrincipalesVideo} type='video/mp4' />
      </video>
      <div class='container'>
        <div class='section-header'>
          <h2 class='section-title'>Actividades Principales</h2>
          <div class='title-underline'></div>
        </div>
        <div class='activities-grid'>
          <div class='activity-card'>
            <div class='activity-icon'>💧</div>
            <h3>Ritual Guardián del Agua</h3>
            <p>
              Purificación y descarga emocional en una cascada natural con
              aromaterapia y elementos rituales.
            </p>
          </div>
          <div class='activity-card'>
            <div class='activity-icon'>🌲</div>
            <h3>Escuchar el Bosque Interior</h3>
            <p>
              Caminata meditativa guiada por la historia del Guardián del
              Bosque.
            </p>
          </div>
          <div class='activity-card'>
            <div class='activity-icon'>💫</div>
            <h3>Taller profundo de heridas emocionales</h3>
            <p>Trabajo intensivo con ejercicios vivenciales y roleplay.</p>
          </div>
          <div class='activity-card'>
            <div class='activity-icon'>🪨</div>
            <h3>Masajes con piedras volcánicas</h3>
            <p>Liberación de tensión física y emocional.</p>
          </div>
          <div class='activity-card'>
            <div class='activity-icon'>⚡</div>
            <h3>Reiki y Alineación de Chakras</h3>
            <p>Equilibrio energético profundo.</p>
          </div>
          <div class='activity-card'>
            <div class='activity-icon'>🌺</div>
            <h3>Terapia floral</h3>
            <p>Armonización emocional complementaria.</p>
          </div>
          <div class='activity-card'>
            <div class='activity-icon'>🔔</div>
            <h3>Terapia de sonido con cuencos</h3>
            <p>Vibración para calmar el sistema nervioso.</p>
          </div>
          <div class='activity-card'>
            <div class='activity-icon'>🔥</div>
            <h3>Chocolatada y Fogata del Alma</h3>
            <p>Espacio íntimo de apertura y liberación.</p>
          </div>
          <div class='activity-card'>
            <div class='activity-icon'>🎶</div>
            <h3>Noche de Alegría y Música en Vivo</h3>
            <p>Movimiento, baile y reconexión con la alegría.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Call to Action Section -->
    <section class='cta-mini-section'>
      <div class='container'>
        <div class='cta-mini-content'>
          <h2 class='cta-mini-title'>¿Dónde te hospedarás?</h2>
          <p class='cta-mini-text'>
            Descubre las hermosas y cómodas instalaciones donde vivirás esta
            experiencia transformadora.
          </p>
          <a href='/acomodaciones' class='cta-mini-button'>
            Ver Acomodaciones
            <span class='arrow'>→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- Horarios Section -->
    <section class='itinerary-section' id='itinerario'>
      <div class='container'>
        <div class='section-header'>
          <h2 class='section-title'>Horarios del Retiro</h2>
          <div class='title-underline'></div>
        </div>

        <div class='schedule-cards'>
          <!-- Llegada -->
          <div class='schedule-card arrival'>
            <div class='schedule-icon'>🌅</div>
            <div class='schedule-content'>
              <span class='schedule-label'>Inicio</span>
              <h3 class='schedule-title'>Viernes de Noviembre</h3>
              <div class='schedule-time'>12:00 p.m.</div>
              <p class='schedule-description'>
                Almuerzo de Bienvenida y Apertura Oficial del Retiro
              </p>
            </div>
          </div>

          <!-- Despedida -->
          <div class='schedule-card departure'>
            <div class='schedule-icon'>🌄</div>
            <div class='schedule-content'>
              <span class='schedule-label'>Cierre</span>
              <h3 class='schedule-title'>Domingo de Noviembre</h3>
              <div class='schedule-time'>11:00 a.m.</div>
              <p class='schedule-description'>
                Ceremonia de Clausura y Cierre del Retiro
              </p>
            </div>
          </div>
        </div>

        <p class='schedule-note'>
          Todas las actividades terapéuticas, holísticas y de reconexión se
          desarrollan dentro de este horario, diseñadas especialmente para tu
          sanación.
        </p>
      </div>
    </section>

    <!-- Testimonials Section -->
    <section class='testimonials-section'>
      <div class='testimonials-bg'>
        <div class='floating-orb orb-1'></div>
        <div class='floating-orb orb-2'></div>
        <div class='floating-orb orb-3'></div>
      </div>

      <div class='container'>
        <div class='testimonials-header'>
          <span class='testimonial-label'>Historias de Transformación</span>
          <h2 class='testimonials-title'>
            Voces que han renacido en DÉSATAME (2025)
          </h2>
          <p class='testimonials-subtitle'>
            Experiencias reales de quienes han vivido el viaje
          </p>
        </div>

        <!-- Video Testimonials -->
        <div class='video-testimonials'>
          <div class='video-card video-featured'>
            <div class='video-wrapper'>
              <video
                controls
                playsinline
                preload='metadata'
                style='position: absolute; top: 0; left: 0; height: 100%; width: 100%; object-fit: cover;'
              >
                <source src={videoTulum1} type='video/mp4' />
              </video>
            </div>
            <div class='video-overlay'>
              <span class='video-badge'>✨ Testimonio Destacado</span>
            </div>
          </div>

          <div class='video-grid'>
            <div class='video-card video-small'>
              <div class='video-wrapper'>
                <video
                  controls
                  playsinline
                  preload='metadata'
                  style='position: absolute; top: 0; left: 0; height: 100%; width: 100%; object-fit: cover;'
                >
                  <source src={videoTulum2} type='video/mp4' />
                </video>
              </div>
            </div>
            <div class='video-card video-small'>
              <div class='video-wrapper'>
                <video
                  controls
                  playsinline
                  preload='metadata'
                  style='position: absolute; top: 0; left: 0; height: 100%; width: 100%; object-fit: cover;'
                >
                  <source src={videoTulum3} type='video/mp4' />
                </video>
              </div>
            </div>
          </div>
        </div>

        <!-- Text Testimonials -->
        <div class='text-testimonials'>
          <div class='testimonial-card testimonial-1'>
            <div class='quote-icon'>"</div>
            <div class='testimonial-content'>
              <p class='testimonial-text'>
                Llegué a CALMA con el corazón roto y la mente llena de ruido. En
                tres días logré lo que meses de terapia no habían conseguido.
                Encontré mi paz interior y aprendí a sostenerme en mi propia
                calma. Este retiro cambió mi vida.
              </p>
              <div class='testimonial-author'>
                <div class='author-avatar'>M</div>
                <div class='author-info'>
                  <h4 class='author-name'>María Fernanda</h4>
                  <p class='author-location'>Bogotá, Colombia</p>
                </div>
              </div>
            </div>
            <div class='testimonial-glow'></div>
          </div>

          <div class='testimonial-card testimonial-2'>
            <div class='quote-icon'>"</div>
            <div class='testimonial-content'>
              <p class='testimonial-text'>
                Nunca había experimentado algo tan profundo. El ritual del agua
                en la cascada, el trabajo con mis heridas de abandono, la
                conexión con el bosque... Cada momento fue sanador. Volví a casa
                siendo una versión más completa de mí misma.
              </p>
              <div class='testimonial-author'>
                <div class='author-avatar'>S</div>
                <div class='author-info'>
                  <h4 class='author-name'>Sofía Jiménez</h4>
                  <p class='author-location'>Medellín, Colombia</p>
                </div>
              </div>
            </div>
            <div class='testimonial-glow'></div>
          </div>

          <div class='testimonial-card testimonial-3'>
            <div class='quote-icon'>"</div>
            <div class='testimonial-content'>
              <p class='testimonial-text'>
                La Dra. Alejandra tiene un don especial para crear espacios
                seguros. Logré soltar traumas que llevaba años cargando. Las
                herramientas que aprendí las uso todos los días. CALMA no es
                solo un retiro, es un renacimiento.
              </p>
              <div class='testimonial-author'>
                <div class='author-avatar'>C</div>
                <div class='author-info'>
                  <h4 class='author-name'>Carolina Restrepo</h4>
                  <p class='author-location'>Cali, Colombia</p>
                </div>
              </div>
            </div>
            <div class='testimonial-glow'></div>
          </div>

          <div class='testimonial-card testimonial-4'>
            <div class='quote-icon'>"</div>
            <div class='testimonial-content'>
              <p class='testimonial-text'>
                Llegué con ansiedad crónica y patrones de pensamiento obsesivos.
                El enfoque que combina psicología científica con prácticas
                espirituales fue exactamente lo que necesitaba. Ahora sé cómo
                calmar mi mente y volver a mi centro.
              </p>
              <div class='testimonial-author'>
                <div class='author-avatar'>L</div>
                <div class='author-info'>
                  <h4 class='author-name'>Laura Martínez</h4>
                  <p class='author-location'>Cartagena, Colombia</p>
                </div>
              </div>
            </div>
            <div class='testimonial-glow'></div>
          </div>

          <div class='testimonial-card testimonial-5'>
            <div class='quote-icon'>"</div>
            <div class='testimonial-content'>
              <p class='testimonial-text'>
                El lugar es mágico, pero lo que realmente transforma es la
                experiencia completa. Cada actividad está diseñada con tanto
                amor y profesionalismo. Salí del retiro sintiendo que había
                recuperado mi alegría de vivir. Gracias infinitas.
              </p>
              <div class='testimonial-author'>
                <div class='author-avatar'>A</div>
                <div class='author-info'>
                  <h4 class='author-name'>Andrea López</h4>
                  <p class='author-location'>Bucaramanga, Colombia</p>
                </div>
              </div>
            </div>
            <div class='testimonial-glow'></div>
          </div>

          <div class='testimonial-card testimonial-6'>
            <div class='quote-icon'>"</div>
            <div class='testimonial-content'>
              <p class='testimonial-text'>
                Después de una ruptura difícil, pensé que nunca volvería a
                sentirme bien. CALMA me dio las herramientas para sanar,
                perdonar y sobre todo, para reconectarme con mi propia esencia.
                Fue el mejor regalo que pude darme.
              </p>
              <div class='testimonial-author'>
                <div class='author-avatar'>D</div>
                <div class='author-info'>
                  <h4 class='author-name'>Diana Vargas</h4>
                  <p class='author-location'>Pereira, Colombia</p>
                </div>
              </div>
            </div>
            <div class='testimonial-glow'></div>
          </div>
        </div>

        <div class='testimonials-cta'>
          <p class='cta-text'>
            ¿Lista para escribir tu propia historia de transformación?
          </p>
          <div class='cta-soldout'>
            <SoldOutBadge label='Cupos Agotados' />
          </div>
          <a
            href='https://transforma-tu-interior.almaymente.io'
            target='_blank'
            rel='noopener noreferrer'
            class='cta-button-testimonials'
          >
            Ver Próximo Retiro
          </a>
        </div>
      </div>
    </section>

    <!-- Por Qué Ir Section -->
    <section class='why-attend-section'>
      <video
        autoplay
        muted
        loop
        playsinline
        class='why-attend-video-bg'
        preload='auto'
      >
        <source src={porqueIrVideo} type='video/mp4' />
      </video>
      <div class='container'>
        <div class='why-attend-header'>
          <span class='decorative-line'></span>
          <h2 class='why-attend-title'>¿Por qué ir a este retiro?</h2>
          <span class='decorative-line'></span>
        </div>

        <div class='why-attend-grid'>
          <div class='why-card card-1'>
            <div class='card-number'>01</div>
            <div class='card-content'>
              <div class='card-icon-large'>🌟</div>
              <p>
                CALMA no es un retiro más; es una <strong
                  >experiencia profunda y transformadora</strong
                > diseñada para sanar desde la mente, el cuerpo y el alma.
              </p>
            </div>
            <div class='card-glow'></div>
