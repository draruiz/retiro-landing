---
import mainLogo from "../../assets/main_logo_brain.png";
import Footer from "../../components/Footer.astro";
import { accommodations } from "../../data/accommodations";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  return accommodations.map((accommodation) => ({
    params: { id: accommodation.id },
    props: { accommodation },
  }));
}

const { accommodation } = Astro.props;

// Helper function to parse price value
const parsePrice = (price: string) => {
  const match = price.match(/[\d,]+/);
  return match ? parseInt(match[0].replace(/,/g, '')) : 0;
};

// Build array of prices with labels and sort by value
const hasMultiplePrices = !!accommodation.priceSingle || !!accommodation.priceMezzanine || !!accommodation.priceBunk || !!accommodation.priceCouple || !!accommodation.priceTwin;

const priceItems: { label: string; shortLabel: string; amount: string; value: number }[] = [];

// Helper to format USD currency
const formatUSD = (amount: number) => `USD $${amount.toLocaleString('en-US')}`;

if (hasMultiplePrices) {
  const baseLabel = accommodation.priceMezzanine ? 'Uso individual' : (accommodation.priceBunk ? 'Cama king' : (accommodation.priceTwin ? 'Cama 1.60m' : (accommodation.priceCouple && !accommodation.priceSingle ? 'Individual' : 'Cama doble')));
  const baseShortLabel = accommodation.priceMezzanine ? 'uso individual' : (accommodation.priceBunk ? 'cama king' : (accommodation.priceTwin ? 'cama 1.60m' : (accommodation.priceCouple && !accommodation.priceSingle ? 'individual' : 'cama doble')));
  priceItems.push({ label: baseLabel, shortLabel: baseShortLabel, amount: accommodation.price, value: parsePrice(accommodation.price) });
  
  if (accommodation.priceMezzanine) {
    priceItems.push({ label: 'Con acompañante (mezanine)', shortLabel: 'con acompañante', amount: accommodation.priceMezzanine, value: parsePrice(accommodation.priceMezzanine) });
  }
  if (accommodation.priceTwin) {
    priceItems.push({ label: 'Cama 1m', shortLabel: 'cama 1m', amount: accommodation.priceTwin, value: parsePrice(accommodation.priceTwin) });
  }
  if (accommodation.priceSingle) {
    priceItems.push({ label: 'Mezzanine', shortLabel: 'mezzanine', amount: accommodation.priceSingle, value: parsePrice(accommodation.priceSingle) });
  }
  if (accommodation.priceBunk) {
    priceItems.push({ label: 'Camarote', shortLabel: 'camarote', amount: accommodation.priceBunk, value: parsePrice(accommodation.priceBunk) });
  }
  if (accommodation.priceCouple) {
    priceItems.push({ label: 'Parejas', shortLabel: 'parejas', amount: accommodation.priceCouple, value: parsePrice(accommodation.priceCouple) });
  }
  
  // Sort by price value (lowest to highest)
  priceItems.sort((a, b) => a.value - b.value);
}
---

<Layout>
  <!-- Navbar -->
  <nav class='navbar' id='navbar'>
    <div class='navbar-container'>
      <div class='navbar-logo'>
        <img src={mainLogo.src} alt='CALMA Logo' class='navbar-logo-img' />
        <span class='navbar-brand'>CALMA</span>
      </div>
      <a href='/acomodaciones' class='back-link'>← Volver</a>
    </div>
  </nav>

  <main class='detail-page'>
    <!-- Hero Section -->
    <section class='detail-hero'>
      <div class='hero-image-wrapper'>
        <img
          src={accommodation.images[0]}
          alt={accommodation.title}
          class='hero-image'
        />
        <div class='hero-overlay'></div>
      </div>
      <div class='hero-content container'>
        <span class='hero-subtitle'>{accommodation.category}</span>
        <h1 class='hero-title'>
          {accommodation.title}
        </h1>
        <div class='hero-price'>
          {priceItems.length > 0 ? (
            <div class='hero-price-dual'>
              {priceItems.map((item, index) => (
                <>
                  {index > 0 && <span class='price-separator'>|</span>}
                  <div class='hero-price-item'>
                    <span class='hero-price-amount'>{item.amount}</span>
                    <span class='per-person'>/ {item.shortLabel}</span>
                  </div>
                </>
              ))}
            </div>
          ) : (
            <>
              {accommodation.price}
              <span class='per-person'>/ persona</span>
            </>
          )}
        </div>
      </div>
    </section>

    <!-- Gallery Section -->
    <section class='gallery-section container'>
      <div class='gallery-grid'>
        {
          accommodation.images.slice(1).map((image) => (
            <div class='gallery-item'>
              <img src={image} alt={accommodation.title} />
            </div>
          ))
        }
      </div>
    </section>

    <!-- Content Section -->
    <section class='detail-content container'>
      <div class='content-grid'>
        <div class='main-info'>
          <h2 class='section-title'>Descripción</h2>
          <p class='description-text'>{accommodation.description}</p>

          {accommodation.sharedNote && (
            <div class='shared-note'>
              <div class='shared-note-icon'>⚠️</div>
              <div class='shared-note-content'>
                <strong>Aclaración importante:</strong>
                <p>{accommodation.sharedNote.replace('Aclaración importante: ', '')}</p>
              </div>
            </div>
          )}

          <div class='amenities-section'>
            <h3 class='subsection-title'>Comodidades</h3>
            <ul class='amenities-grid'>
              {
                accommodation.amenities.map((amenity) => (
                  <li class='amenity-item'>
                    <span class='check-icon'>✓</span>
                    {amenity}
                  </li>
                ))
              }
            </ul>
          </div>

          <!-- Payment Plan Section -->
          <div class='payment-plan-section'>
            <h2 class='section-title'>Plan de Pago – Retiro Calma</h2>
            <p class='payment-intro'>
              Para facilitar tu inscripción, contamos con un sistema de pago en <strong>4 cuotas</strong> con reserva del 20%.
            </p>

            <div class='payment-how-it-works'>
              <h4 class='how-title'>✅ Cómo funciona</h4>
              <ul class='how-list'>
                <li><strong>20%</strong> para reservar tu cupo</li>
                <li>El <strong>80%</strong> restante se divide en 3 cuotas iguales</li>
                <li>El 100% debe estar totalmente pagado <strong>antes del 15 de abril</strong></li>
                <li>La reserva <strong>no es reembolsable</strong></li>
                <li>Cupos limitados por tipo de habitación</li>
              </ul>
            </div>

            <div class='payment-examples'>
              <h4 class='examples-title'>🔹 Ejemplo de Plan de Pago</h4>
              
              {priceItems.length > 0 ? (
                priceItems.map((item) => {
                  const totalPrice = item.value;
                  const reserva = Math.round(totalPrice * 0.20);
                  const cuota = Math.round((totalPrice * 0.80) / 3);
                  return (
                    <div class='example-card'>
                      <div class='example-header'>
                        <span class='example-badge'>{item.label}</span>
                        <span class='example-total'>{formatUSD(totalPrice)}</span>
                      </div>
                      <div class='example-breakdown'>
                        <div class='breakdown-item'>
                          <span class='breakdown-label'>Reserva (20%):</span>
                          <span class='breakdown-amount'>{formatUSD(reserva)}</span>
                        </div>
                        <div class='breakdown-item'>
                          <span class='breakdown-label'>Cuota 2:</span>
                          <span class='breakdown-amount'>{formatUSD(cuota)}</span>
                        </div>
                        <div class='breakdown-item'>
                          <span class='breakdown-label'>Cuota 3:</span>
                          <span class='breakdown-amount'>{formatUSD(cuota)}</span>
                        </div>
                        <div class='breakdown-item highlight'>
                          <span class='breakdown-label'>Cuota 4 (límite 15 abril):</span>
                          <span class='breakdown-amount'>{formatUSD(cuota)}</span>
                        </div>
                      </div>
                    </div>
                  );
                })
              ) : (
                (() => {
                  const totalPrice = parsePrice(accommodation.price);
                  const reserva = Math.round(totalPrice * 0.20);
                  const cuota = Math.round((totalPrice * 0.80) / 3);
                  return (
                    <div class='example-card'>
                      <div class='example-header'>
                        <span class='example-badge'>Por persona</span>
                        <span class='example-total'>{formatUSD(totalPrice)}</span>
                      </div>
                      <div class='example-breakdown'>
                        <div class='breakdown-item'>
                          <span class='breakdown-label'>Reserva (20%):</span>
                          <span class='breakdown-amount'>{formatUSD(reserva)}</span>
                        </div>
                        <div class='breakdown-item'>
                          <span class='breakdown-label'>Cuota 2:</span>
                          <span class='breakdown-amount'>{formatUSD(cuota)}</span>
                        </div>
                        <div class='breakdown-item'>
                          <span class='breakdown-label'>Cuota 3:</span>
                          <span class='breakdown-amount'>{formatUSD(cuota)}</span>
                        </div>
                        <div class='breakdown-item highlight'>
                          <span class='breakdown-label'>Cuota 4 (límite 15 abril):</span>
                          <span class='breakdown-amount'>{formatUSD(cuota)}</span>
                        </div>
                      </div>
                    </div>
                  );
                })()
              )}
            </div>
          </div>
        </div>

        <div class='booking-sidebar'>
          <div class='booking-card'>
            <h3 class='card-title'>Reserva tu lugar</h3>
            <div class='price-display'>
              {priceItems.length > 0 ? (
                <div class='price-options'>
                  {priceItems.map((item) => (
                    <div class='price-option'>
                      <span class='option-label'>{item.label}</span>
                      <span class='amount'>{item.amount}</span>
                    </div>
                  ))}
                </div>
              ) : (
                <>
                  <span class='amount'>{accommodation.price}</span>
                  <span class='period'>{accommodation.priceLabel}</span>
                </>
              )}
            </div>
            <p class='booking-note'>
              Incluye alojamiento completo durante los 3 días del retiro, todas
              las comidas, actividades terapéuticas y holísticas, materiales y
              acceso a todas las instalaciones.
            </p>
            <a href='https://wa.me/18135686424' target='_blank' rel='noopener noreferrer' class='book-btn'>Iniciar Inscripción</a>
            <p class='limited-spots'>Cupos limitados</p>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&display=swap");

  :root {
    --color-bg: #0a0a0f;
    --color-text: #e2e8f0;
    --color-accent: #c9a961;
    --color-dark-card: #12121a;
    --font-heading: "Cormorant Garamond", serif;
    --font-body: "Inter", sans-serif;
  }

  body {
    background-color: var(--color-bg);
    color: var(--color-text);
    font-family: var(--font-body);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Navbar */
  .navbar {
    position: fixed;
    top: 0;
    width: 100%;
    padding: 1.5rem 0;
    background: rgba(10, 10, 15, 0.8);
    backdrop-filter: blur(15px);
    z-index: 1000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .navbar-container {
    max-width: 1600px;
    margin: 0 auto;
    padding: 0 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .navbar-logo {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .navbar-logo-img {
    width: 40px;
    height: 40px;
    filter: brightness(0) invert(1);
  }

  .navbar-brand {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    letter-spacing: 0.1em;
    color: #fff;
  }

  .back-link {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.3s;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  /* Hero */
  .detail-hero {
    height: 70vh;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding-bottom: 6rem;
  }

  .hero-image-wrapper {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--color-bg) 10%, transparent 80%);
  }

  .hero-content {
    position: relative;
    z-index: 10;
    width: 100%;
  }

  .hero-subtitle {
    display: block;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    font-size: 0.9rem;
    margin-bottom: 1rem;
    animation: fadeInUp 0.8s ease-out;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 6vw, 5rem);
    line-height: 1;
    margin-bottom: 1rem;
    color: #fff;
  }

  .hero-price {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .per-person {
    font-family: var(--font-body);
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .hero-price-dual {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-price-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .hero-price-amount {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    color: rgba(255, 255, 255, 0.9);
  }

  .price-separator {
    color: rgba(255, 255, 255, 0.3);
    font-size: 2rem;
  }

  /* Gallery */
  .gallery-section {
    padding: 4rem 2rem;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 1rem;
  }

  .gallery-item {
    aspect-ratio: 4/3;
    overflow: hidden;
    border-radius: 4px;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .gallery-item:hover img {
    transform: scale(1.05);
  }

  /* Content */
  .detail-content {
    padding: 4rem 2rem 6rem;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 6rem;
  }

  .section-title {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    margin-bottom: 2rem;
    color: var(--color-accent);
  }

  .description-text {
    font-size: 1.1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 2rem;
  }

  .shared-note {
    display: flex;
    gap: 1rem;
    background: rgba(201, 169, 97, 0.08);
    border: 1px solid rgba(201, 169, 97, 0.25);
    border-left: 4px solid var(--color-accent);
    border-radius: 4px;
    padding: 1.5rem;
    margin-bottom: 4rem;
  }

  .shared-note-icon {
    font-size: 1.5rem;
    flex-shrink: 0;
  }

  .shared-note-content {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .shared-note-content strong {
    color: var(--color-accent);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .shared-note-content p {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
  }

  .subsection-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    margin-bottom: 2rem;
    color: #fff;
  }

  .amenities-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    list-style: none;
  }

  .amenity-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: rgba(255, 255, 255, 0.7);
    font-size: 1rem;
    padding: 1rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 4px;
  }

  .check-icon {
    color: var(--color-accent);
  }

  /* Payment Plan Section */
  .payment-plan-section {
    margin-top: 4rem;
    padding-top: 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .payment-intro {
    font-size: 1.1rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 2rem;
  }

  .payment-intro strong {
    color: var(--color-accent);
  }

  .payment-how-it-works {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    padding: 2rem;
    margin-bottom: 2.5rem;
  }

  .how-title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: #fff;
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }

  .how-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .how-list li {
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.95rem;
    line-height: 1.6;
    padding-left: 1.5rem;
    position: relative;
  }

  .how-list li::before {
    content: "•";
    position: absolute;
    left: 0;
    color: var(--color-accent);
  }

  .how-list li strong {
    color: var(--color-accent);
  }

  .payment-examples {
    margin-top: 2rem;
  }

  .examples-title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }

  .example-card {
    background: linear-gradient(135deg, rgba(201, 169, 97, 0.08) 0%, rgba(201, 169, 97, 0.02) 100%);
    border: 1px solid rgba(201, 169, 97, 0.25);
    border-radius: 12px;
    padding: 1.5rem;
    margin-bottom: 1rem;
  }

  .example-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.25rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(201, 169, 97, 0.2);
  }

  .example-badge {
    background: var(--color-accent);
    color: #000;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.4rem 0.8rem;
    border-radius: 4px;
  }

  .example-total {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    color: #fff;
    font-weight: 500;
  }

  .example-breakdown {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .breakdown-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
  }

  .breakdown-item.highlight {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1rem;
    margin-top: 0.5rem;
  }

  .breakdown-label {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.9rem;
  }

  .breakdown-item.highlight .breakdown-label {
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
  }

  .breakdown-amount {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    color: var(--color-accent);
    font-weight: 500;
  }

  .breakdown-item.highlight .breakdown-amount {
    font-size: 1.2rem;
  }

  /* Sidebar */
  .booking-card {
    background: var(--color-dark-card);
    padding: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.05);
    position: sticky;
    top: 8rem;
    border-radius: 8px;
  }

  .card-title {
    font-family: var(--font-heading);
    font-size: 1.8rem;
    margin-bottom: 1.5rem;
    color: #fff;
  }

  .price-display {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .amount {
    display: block;
    font-size: 2rem;
    font-family: var(--font-heading);
    color: var(--color-accent);
  }

  .period {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .price-options {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .price-option {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .price-option:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .option-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.5);
  }

  .price-options .amount {
    font-size: 1.75rem;
  }

  .booking-note {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .book-btn {
    display: block;
    width: 100%;
    padding: 1rem;
    background: var(--color-accent);
    color: #000;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    transition: all 0.3s;
  }

  .book-btn:hover {
    background: #fff;
  }

  .limited-spots {
    text-align: center;
    margin-top: 1rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.4);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: 1fr;
      gap: 4rem;
    }
    .detail-hero {
      height: 60vh;
    }
    .hero-title {
      font-size: 3rem;
    }
    .booking-card {
      position: static;
    }
    .payment-plan-section {
      margin-top: 3rem;
      padding-top: 3rem;
    }
    .payment-how-it-works {
      padding: 1.5rem;
    }
    .example-card {
      padding: 1.25rem;
    }
    .example-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .example-total {
      font-size: 1.3rem;
    }
